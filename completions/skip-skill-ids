_sei_skip_skill_ids::complete() {
  if ((COMP_CWORD != 1)); then
    return 0
  fi

  if [[ $2 == @(-|-h) ]]; then
    COMPREPLY=("-h")

    return 0
  fi

  # Fall back to readline's default filename completion so files and folders can be walked step by step.
  compopt -o default

  return 0
} && complete -o bashdefault -F _sei_skip_skill_ids::complete skip-skill-ids

