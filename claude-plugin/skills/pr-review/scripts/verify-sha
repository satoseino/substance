#!/usr/bin/env bash

set -eu -o pipefail

source "$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)/lib/gh-preflight.sh"

_pr_url_regex='^https://github\.com/[^/]+/[^/]+/pull/[0-9]+/?$'

main() {
  if (($# > 0)) && [[ $1 == "-h" ]]; then
    cat <<'EOF'
Usage: verify-sha [-h] PR_URL

Verify that the local HEAD SHA matches the PR's current head commit, as
reported by `gh pr view --json headRefOid`. Works the same for PRs from a
branch of the upstream repo and PRs from a fork, and for any local checkout
method (named branch, `pr/N` branch, or detached HEAD). Requires the `gh` CLI
(>= 2.81.0) to be installed and authenticated; missing gh, an unsupported gh
version, or not being logged in is reported as `ERROR: <reason>`. Except with
`-h`, prints exactly one of the following to stdout for consumption by an LLM:

    VERIFY-SHA: PASS
    VERIFY-SHA: FAIL — <details>
    ERROR: <reason>

Always exits 0; the outcome is conveyed by stdout alone.

ARGUMENTS:
    PR_URL      Full URL to the GitHub pull request, e.g.
                https://github.com/owner/repo/pull/123

OPTIONS:
    -h          Show this help message
EOF

    return 0
  fi

  if (($# != 1)); then
    echo "ERROR: verify-sha requires exactly one positional argument PR_URL"

    return 0
  fi

  local pr_url=$1

  if ! [[ $pr_url =~ $_pr_url_regex ]]; then
    echo "ERROR: not a GitHub PR URL: $pr_url"

    return 0
  fi

  local gh_check
  if ! gh_check=$(_gh_preflight); then
    echo "$gh_check"

    return 0
  fi

  if ! stderr_file=$(mktemp 2>&1); then
    echo "ERROR: $stderr_file"

    return 0
  fi
  trap 'rm -f "$stderr_file"' EXIT

  local remote_sha
  if ! remote_sha=$(gh pr view "$pr_url" --json headRefOid --jq '.headRefOid' 2>"$stderr_file"); then
    echo "ERROR: $(<"$stderr_file")"

    return 0
  fi

  if ! [[ $remote_sha =~ ^[0-9a-f]{40}$ ]]; then
    echo "ERROR: unexpected PR head SHA from gh: '$remote_sha'"

    return 0
  fi

  local local_sha
  if ! local_sha=$(git rev-parse HEAD 2>"$stderr_file"); then
    echo "ERROR: $(<"$stderr_file")"

    return 0
  fi

  if [[ $local_sha != "$remote_sha" ]]; then
    echo "VERIFY-SHA: FAIL — local HEAD $local_sha ≠ PR head $remote_sha"

    return 0
  fi

  echo "VERIFY-SHA: PASS"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
