#!/usr/bin/env bash

set -eu -o pipefail

main() {
  if (($# > 0)) && [[ $1 == "-h" ]]; then
    cat <<'EOF'
Usage: merge-on-base [-h] <base> <path>

Redoes the three-way merge of one path of an in-progress merge with <base> as the
common ancestor, instead of the merge base Git used. Git's merge base predates the
original old-base commits, so Git merges them against the squash commit as competing
edits. With <base> as the ancestor, only the stacked branch's own changes
(<base> → HEAD) and the target's changes since <base> (<base> → MERGE_HEAD) are merged.

Writes the result over <path> in the working tree, with checkout filters applied to it.
Like Git, it merges the three versions in their repository form, except for a path with
a `filter` attribute (e.g. Git LFS), whose versions are merged with filters applied.
Overlapping changes are left as diff3-style conflict blocks in Git's order: HEAD's
lines first, then BASE's, then MERGE_HEAD's, labeled with those names. Stages nothing.
Requires Git 2.43 or later.

<path> is relative to the repository's top level, as `git diff --name-only` prints it.
It must be a regular file (not a symlink or submodule) in each of HEAD and MERGE_HEAD
that has it; if <base> lacks it, an empty ancestor is used.

A change only one side made since <base> needs no merge, so it also works for binaries:
if both sides are equal (mode and blob), that version is written; if one side equals
<base>, the other side's version is written. If one
side lacks the path, the other side's version is written when <base> lacks it too, and
the file is removed when the other side equals <base>; if the other side changed it,
that is a modify/delete case and an ERROR. A path both sides deleted is removed.

Except with `-h`, prints one of the following to stdout for consumption by an LLM:

    MERGE: CLEAN

    MERGE: CONFLICTS <n>

    ERROR: <reason>

Always exits 0; the outcome is conveyed by stdout alone.

ARGUMENTS:
    base        BASE from preflight: the last old-base commit the stacked branch contains
    path        The path to merge, relative to the repository's top level

OPTIONS:
    -h          Show this help message
EOF

    return 0
  fi

  if (($# != 2)); then
    echo "ERROR: merge-on-base takes exactly two positional arguments: <base> <path>"

    return 0
  fi

  local base=$1 path=$2

  # <path> is fed to `git ls-tree` as a pathspec; match it literally.
  export GIT_LITERAL_PATHSPECS=1

  local toplevel
  if ! toplevel=$(git rev-parse --show-toplevel 2>&1) || ! cd "$toplevel"; then
    echo "ERROR: cannot enter the repository's top level: $toplevel"

    return 0
  fi

  if ! git rev-parse -q --verify MERGE_HEAD >/dev/null; then
    echo "ERROR: no merge in progress (MERGE_HEAD missing)"

    return 0
  fi

  if ! git rev-parse -q --verify "$base^{commit}" >/dev/null; then
    echo "ERROR: '$base' is not a commit"

    return 0
  fi

  # Each side's entry is "<mode> <object id>", or empty when the side lacks the path.
  local head_entry merge_entry base_entry
  head_entry=$(tree_entry HEAD "$path")
  merge_entry=$(tree_entry MERGE_HEAD "$path")
  base_entry=$(tree_entry "$base" "$path")

  # A symlink is a blob too, but writing the merged result through it would overwrite
  # its target, so only regular files (mode 100644 or 100755) are accepted.
  local rev entry mode
  for rev in HEAD MERGE_HEAD; do
    entry=$head_entry
    [[ $rev == MERGE_HEAD ]] && entry=$merge_entry
    [[ -z $entry ]] && continue
    mode=${entry%% *}
    if [[ $mode != 100644 && $mode != 100755 ]]; then
      echo "ERROR: '$path' is not a regular file in $rev (mode $mode); resolve it by hand"

      return 0
    fi
  done

  if ! tmp_dir=$(mktemp -d 2>&1); then
    echo "ERROR: $tmp_dir"

    return 0
  fi
  trap 'rm -rf "$tmp_dir"' EXIT

  # With <base> as the ancestor, a change only one side made has a single correct
  # result: the changed side's version (or its absence), as does the same change made
  # on both sides. Only a path both sides changed differently goes through
  # `git merge-file`, which refuses binary input even when one side equals the
  # ancestor or the two sides are identical.
  local side=""
  if [[ -z $head_entry && -z $merge_entry ]]; then
    if [[ -z $base_entry ]]; then
      echo "ERROR: '$path' is absent from HEAD, MERGE_HEAD and $base"

      return 0
    fi
    remove_path "$path" "$tmp_dir" && echo "MERGE: CLEAN"

    return 0
  elif [[ -z $head_entry || -z $merge_entry ]]; then
    local present=HEAD absent=MERGE_HEAD present_entry=$head_entry
    if [[ -z $head_entry ]]; then
      present=MERGE_HEAD absent=HEAD present_entry=$merge_entry
    fi
    if [[ -z $base_entry ]]; then
      side=$present
    elif [[ $base_entry == "$present_entry" ]]; then
      remove_path "$path" "$tmp_dir" && echo "MERGE: CLEAN"

      return 0
    else
      echo "ERROR: '$path' is absent from $absent and changed in $present since $base; resolve it as a modify/delete case"

      return 0
    fi
  elif [[ $head_entry == "$merge_entry" ]]; then
    # Both sides made the same change (or none): nothing to merge.
    side=HEAD
  elif [[ $base_entry == "$head_entry" ]]; then
    side=MERGE_HEAD
  elif [[ $base_entry == "$merge_entry" ]]; then
    side=HEAD
  fi

  if [[ -n $side ]]; then
    if ! git cat-file --filters --path="$path" "$side:$path" >"$tmp_dir/out" 2>"$tmp_dir/stderr"; then
      echo "ERROR: $(<"$tmp_dir/stderr")"

      return 0
    fi
    local side_mode=${head_entry%% *}
    [[ $side == MERGE_HEAD ]] && side_mode=${merge_entry%% *}
    write_path "$path" "$tmp_dir" "$side_mode" && echo "MERGE: CLEAN"

    return 0
  fi

  # Both sides changed the path since <base> (or <base> lacks it): merge the three.
  # The ancestor is <base>'s blob, or the empty blob when <base> lacks the path.
  local base_spec="$base:$path"
  if [[ "$(git cat-file -t "$base_spec" 2>/dev/null)" != blob ]] &&
    ! base_spec=$(git hash-object -w --stdin </dev/null 2>"$tmp_dir/stderr"); then
    echo "ERROR: $(<"$tmp_dir/stderr")"

    return 0
  fi

  # Like Git's own merge, merge the blobs in their repository (clean) form and apply checkout
  # filters only to the result: smudging the three inputs first would make e.g. an `ident`
  # line differ in all of them and always conflict. A `filter` driver (e.g. Git LFS) is the
  # exception: its clean form is a stand-in such as an LFS pointer, whose merge is
  # meaningless, so with one set the inputs are smudged and merged as files instead.
  local filter_attr
  filter_attr=$(git check-attr -z filter -- "$path" 2>/dev/null | tr '\0' '\n' | sed -n 3p || true)

  # Exit status: 0 when clean, the number of conflicts (capped at 127) otherwise, and
  # above 127 on errors such as binary input. HEAD is the current side, as in Git's own
  # conflict markers: its lines come first in each conflict block.
  local rc=0 merged
  if [[ -z $filter_attr || $filter_attr == unspecified || $filter_attr == unset ]]; then
    merged=$(git merge-file --object-id --diff3 -L HEAD -L BASE -L MERGE_HEAD \
      "HEAD:$path" "$base_spec" "MERGE_HEAD:$path" 2>"$tmp_dir/stderr") || rc=$?
    if ((rc <= 127)) &&
      ! git cat-file --filters --path="$path" "$merged" >"$tmp_dir/out" 2>"$tmp_dir/stderr"; then
      echo "ERROR: $(<"$tmp_dir/stderr")"

      return 0
    fi
  else
    local rev spec
    for rev in HEAD base MERGE_HEAD; do
      spec="$rev:$path"
      [[ $rev == base ]] && spec=$base_spec
      if ! git cat-file --filters --path="$path" "$spec" >"$tmp_dir/$rev" 2>"$tmp_dir/stderr"; then
        echo "ERROR: $(<"$tmp_dir/stderr")"

        return 0
      fi
    done
    git merge-file -p --diff3 -L HEAD -L BASE -L MERGE_HEAD \
      "$tmp_dir/HEAD" "$tmp_dir/base" "$tmp_dir/MERGE_HEAD" >"$tmp_dir/out" 2>"$tmp_dir/stderr" || rc=$?
  fi
  if ((rc > 127)); then
    echo "ERROR: git merge-file failed for '$path': $(<"$tmp_dir/stderr")"

    return 0
  fi

  if ! write_path "$path" "$tmp_dir" ""; then
    return 0
  fi

  if ((rc == 0)); then
    echo "MERGE: CLEAN"
  else
    echo "MERGE: CONFLICTS $rc"
  fi
}

# Prints "<mode> <object id>" of <path> in <rev>, or nothing when <rev> lacks it.
tree_entry() {
  git ls-tree --format='%(objectmode) %(objectname)' "$1" -- "$2" 2>/dev/null || true
}

# write_path <path> <tmp_dir> <mode>
# Writes <tmp_dir>/out over <path>. An existing file is redirected into, so it keeps its
# mode. A missing one is created along with its parent directories, executable when
# <mode> is 100755. On failure prints `ERROR: …` and returns 1.
write_path() {
  local path=$1 tmp_dir=$2 mode=$3
  if [[ ! -e $path ]]; then
    if [[ $path == */* ]] && ! mkdir -p "${path%/*}" 2>"$tmp_dir/stderr"; then
      echo "ERROR: cannot create the parent directory of '$path': $(<"$tmp_dir/stderr")"

      return 1
    fi
  else
    mode=""
  fi

  # Redirect instead of moving, so an existing working-tree file keeps its mode.
  if ! cat "$tmp_dir/out" >"$path" 2>"$tmp_dir/stderr"; then
    echo "ERROR: cannot write '$path': $(<"$tmp_dir/stderr")"

    return 1
  fi

  if [[ $mode == 100755 ]] && ! chmod +x "$path" 2>"$tmp_dir/stderr"; then
    echo "ERROR: cannot make '$path' executable: $(<"$tmp_dir/stderr")"

    return 1
  fi
}

# remove_path <path> <tmp_dir>
# Removes <path> from the working tree if present; never touches the index. On failure
# prints `ERROR: …` and returns 1.
remove_path() {
  local path=$1 tmp_dir=$2
  if [[ -e $path || -L $path ]] && ! rm -f "$path" 2>"$tmp_dir/stderr"; then
    echo "ERROR: cannot remove '$path': $(<"$tmp_dir/stderr")"

    return 1
  fi
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
