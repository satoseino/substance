#!/usr/bin/env bash

set -eu -o pipefail

source "$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)/../lib/utils.sh"

main() {
  if (($# > 0)) && [[ $1 == "-h" ]]; then
    cat <<'EOF'
Usage: wsl-browser [-h] TARGET

Open a URL in the Windows default browser, or a local file with its
default Windows handler, from WSL2.
Intended as the $BROWSER value, which xdg-open falls back to when
explorer.exe is not on PATH (appendWindowsPath = false).

ARGUMENTS:
    TARGET      URL, file:// URL, or path to a local file

OPTIONS:
    -h          Show this help message
EOF

    return 0
  fi

  if (($# != 1)); then
    sei::log_error "wsl-browser expects exactly one argument"

    return 1
  fi

  local target="$1"

  # Turn file:// URLs into plain paths, percent-decoding them.
  if [[ $target == file://* ]]; then
    target="${target#file://}"
    target="$(printf '%b' "${target//%/\\x}")"
  fi

  # Linux paths must become Windows paths (\\wsl.localhost\...) for the Windows side.
  # rundll32's FileProtocolHandler silently ignores UNC paths, so local files go through
  # explorer.exe, which handles them but exits 1 even on success.
  if [[ -e $target ]]; then
    "$(wslpath -u 'C:\Windows\explorer.exe')" "$(wslpath -aw "$target")" || (($? == 1))

    return 0
  fi

  # rundll32 for URLs: unlike explorer.exe, it exits 0 on success, which keeps
  # xdg-open (and callers such as pkg/browser) from reporting a failure.
  "$(wslpath -u 'C:\Windows\System32\rundll32.exe')" url.dll,FileProtocolHandler "$target"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
