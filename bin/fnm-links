#!/usr/bin/env bash

set -eu -o pipefail

source "$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)/../lib/utils.sh"

# Convert a DURATION like 90s, 30m, 12h, 1d, 2w (or a bare number of days) into whole minutes,
# rounding up. `find -mmin` is the only age test with sub-day precision that both GNU find (Linux)
# and BSD find (macOS) accept.
_duration_to_minutes() {
  if ! [[ "$1" =~ ^([[:digit:]]+)([smhdw]?)$ ]]; then
    sei::log_error "Invalid DURATION '${1}'. Expected a number with an optional unit of s, m, h, d or w."

    return 1
  fi

  local num="${BASH_REMATCH[1]}"

  case "${BASH_REMATCH[2]}" in
  s) echo $(((num + 59) / 60)) ;;
  m) echo "$num" ;;
  h) echo $((num * 60)) ;;
  d | '') echo $((num * 60 * 24)) ;;
  w) echo $((num * 60 * 24 * 7)) ;;
  esac
}

_clean() {
  if [[ -z "${FNM_MULTISHELL_PATH:+x}" ]]; then
    sei::log_error "The FNM_MULTISHELL_PATH environment variable is not set."

    return 1
  fi

  local fnm_multishell_dir
  fnm_multishell_dir="$(dirname "$FNM_MULTISHELL_PATH")"

  if [[ -z "$1" ]]; then
    sei::log_info "Cleaning up all symlinks in the ${fnm_multishell_dir} directory."

    find "${fnm_multishell_dir}/" -type l -name '*_*' -exec rm {} +
  else
    local minutes
    minutes="$(_duration_to_minutes "$1")"

    sei::log_info "Cleaning up the ${fnm_multishell_dir} directory of symlinks older than ${1}."

    find "${fnm_multishell_dir}/" -type l -name '*_*' -mmin "+${minutes}" -exec rm {} +
  fi
}

_count() {
  local fnm_multishell_dir
  fnm_multishell_dir="$(dirname "$FNM_MULTISHELL_PATH"/)"

  [[ -d "$fnm_multishell_dir" ]] && find "$fnm_multishell_dir" -type l | wc -l
}

_list() {
  if [[ -z "${FNM_MULTISHELL_PATH:+x}" || ! -d "$(dirname "$FNM_MULTISHELL_PATH")" ]]; then
    sei::log_error "The FNM_MULTISHELL_PATH environment variable does not have a valid value."

    return 1
  fi

  if [[ "$1" =~ ^-[[:digit:]]+$ ]]; then
    # shellcheck disable=SC2012
    ls -al "$(dirname "$FNM_MULTISHELL_PATH")" | tail "$1"
  else
    ls -al "$(dirname "$FNM_MULTISHELL_PATH")"
  fi
}

main() {
  if (($# == 0)) || [[ $1 == "-h" ]]; then
    cat <<'EOF'
USAGE: fnm-links [-h] [SUBCOMMAND] [-N] [DURATION]

SUBCOMMANDS:
    list  [-N]          List existing symlinks. If N is an integer, list the newest N links.
    count               Count the number of existing symlinks for fnm.
    clean [DURATION]    Clean up fnm symlinks older than DURATION (e.g. 90s, 30m, 12h, 1d, 2w;
                        a bare number means days). Without DURATION, remove ALL symlinks,
                        including those of still-open shells - run it right before closing
                        every shell, or `exec bash` in any shell kept open afterwards.

OPTIONS:
    -h                  Show this help message
EOF

    return 0
  fi

  case "$1" in
  count)
    _count
    ;;
  clean)
    _clean "${2:-}"
    ;;
  list | ls)
    _list "${2:-}"
    ;;
  *)
    sei::log_info "fnm-links requires a subcommand - list, count or clean."

    return 1
    ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
